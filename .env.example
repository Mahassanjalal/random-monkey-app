# Buddy — environment template. Copy to backend/.env for local dev.
# NEVER commit real secrets.

# --- Core ---
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:4000
JWT_SECRET=change-me-to-a-64-char-random-string-in-production

# --- Database ---
# Dev: SQLite. Prod: PostgreSQL.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Production example: DATABASE_URL="postgresql://buddy:pass@db-host:5432/buddy?schema=public"

# --- Redis (presence/queues; app runs degraded without it) ---
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# --- WebRTC / TURN ---
ICE_SERVERS=stun:stun.l.google.com:19302
# Shared secret for dynamic time-limited TURN credentials (coturn --use-auth-secret).
# When set, the API generates per-match TURN credentials automatically.
TURN_SECRET=dev-only-turn-secret-change-me
# How long generated TURN credentials remain valid (seconds). Default: 86400 (24h).
TURN_TTL_SEC=86400
# Static TURN fallback (legacy; only used when TURN_SECRET is not set).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Age assurance (required before public launch; see docs/age-assurance.md) ---
AGE_ASSURANCE_PROVIDER=none
AGE_ASSURANCE_API_KEY=
AGE_ASSURANCE_ENDPOINT=

# --- Moderation (optional; text AI moderation) ---
MODERATION_PROVIDER=none
MODERATION_API_KEY=

# --- Payments (DISABLED | STRIPE) ---
PAYMENTS_PROVIDER=DISABLED
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- OAuth (optional; entry points hidden when unset) ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GITHUB_CLIENT_ID=

# --- Matching policy defaults (overridable via admin API) ---
MALE_QUEUE_ALLOCATION_TARGET_PCT=50
SPARSE_POOL_THRESHOLD=8
FAIR_WAIT_BOOST=true
QUEUE_TIMEOUT_MS=120000

# --- Observability ---
LOG_LEVEL=info
SERVICE_NAME=buddy-api
